{
  "$comment": "Pattern 8b: fan out inside one run. One inbound message carries N items; orders-loop runs a For each (concurrency 20) that calls the process-order child per item. Load: 1 envelope every 5 s x 50 items = 10 items/s. See README.md.",
  "location": "westus3",
  "fallbackLocation": "swedencentral",
  "planSku": "WS1",
  "maximumElasticWorkerCount": 20,
  "minimumElasticInstanceCount": 1,
  "serviceBusSku": "Standard",
  "queues": [
    { "name": "orders", "lockDuration": "PT5M", "maxDeliveryCount": 10, "maxSizeInMegabytes": 5120 }
  ],
  "topics": [],
  "extraAppSettings": {},
  "hostSettings": {},
  "loadTest": {
    "queueName": "orders",
    "engineInstances": 1,
    "users": 1,
    "spawnRate": 1,
    "batchSize": 1,
    "batchesPerUserPerSecond": 0.2,
    "durationMinutes": 5,
    "env": {
      "ITEMS_PER_MESSAGE": "50",
      "BAD_ITEM_PERCENT": "4"
    }
  },
  "drainMinutes": 8,
  "measurement": {
    "workflowName": "orders-loop"
  }
}
