{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "When_messages_are_available_in_a_session": {
        "type": "ServiceProvider",
        "kind": "Polling",
        "inputs": {
          "parameters": {
            "queueName": "orders-literal",
            "maxMessages": 50
          },
          "serviceProviderConfiguration": {
            "connectionName": "serviceBus",
            "operationId": "onNewMessagesFromQueueSession",
            "serviceProviderId": "/serviceProviders/serviceBus"
          }
        },
        "recurrence": {
          "frequency": "Second",
          "interval": 5
        }
      }
    },
    "actions": {
      "Init_lines": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "lines",
              "type": "array",
              "value": "@triggerBody()"
            }
          ]
        },
        "runAfter": {}
      },
      "Init_expected": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "expected",
              "type": "integer",
              "value": "@int(coalesce(first(triggerBody())?['contentData']?['lineCount'], 1))"
            }
          ]
        },
        "runAfter": {
          "Init_lines": [
            "Succeeded"
          ]
        }
      },
      "Complete_first_batch": {
        "type": "Foreach",
        "foreach": "@triggerBody()",
        "actions": {
          "Complete_first": {
            "type": "ServiceProvider",
            "inputs": {
              "parameters": {
                "queueName": "orders-literal",
                "messageId": "@items('Complete_first_batch')?['messageId']",
                "lockToken": "@items('Complete_first_batch')?['lockToken']"
              },
              "serviceProviderConfiguration": {
                "connectionName": "serviceBus",
                "operationId": "completeMessageInSession",
                "serviceProviderId": "/serviceProviders/serviceBus"
              }
            }
          }
        },
        "runAfter": {
          "Init_expected": [
            "Succeeded"
          ]
        },
        "runtimeConfiguration": {
          "concurrency": {
            "repetitions": 1
          }
        }
      },
      "Until_group_complete": {
        "type": "Until",
        "expression": "@greaterOrEquals(length(variables('lines')), variables('expected'))",
        "limit": {
          "count": 20,
          "timeout": "PT2M"
        },
        "actions": {
          "Get_more_from_session": {
            "type": "ServiceProvider",
            "inputs": {
              "parameters": {
                "queueName": "orders-literal",
                "sessionId": "@first(triggerBody())?['sessionId']",
                "maxMessages": 50
              },
              "serviceProviderConfiguration": {
                "connectionName": "serviceBus",
                "operationId": "getMessagesFromQueueSession",
                "serviceProviderId": "/serviceProviders/serviceBus"
              }
            }
          },
          "For_each_more": {
            "type": "Foreach",
            "foreach": "@coalesce(body('Get_more_from_session'), json('[]'))",
            "runtimeConfiguration": {
              "concurrency": {
                "repetitions": 1
              }
            },
            "actions": {
              "Append_line": {
                "type": "AppendToArrayVariable",
                "inputs": {
                  "name": "lines",
                  "value": "@items('For_each_more')"
                }
              },
              "Complete_more": {
                "type": "ServiceProvider",
                "inputs": {
                  "parameters": {
                    "queueName": "orders-literal",
                    "messageId": "@items('For_each_more')?['messageId']",
                    "lockToken": "@items('For_each_more')?['lockToken']"
                  },
                  "serviceProviderConfiguration": {
                    "connectionName": "serviceBus",
                    "operationId": "completeMessageInSession",
                    "serviceProviderId": "/serviceProviders/serviceBus"
                  }
                },
                "runAfter": {
                  "Append_line": [
                    "Succeeded"
                  ]
                }
              }
            },
            "runAfter": {
              "Get_more_from_session": [
                "Succeeded"
              ]
            }
          }
        },
        "runAfter": {
          "Complete_first_batch": [
            "Succeeded"
          ]
        }
      },
      "Select_line_numbers": {
        "type": "Select",
        "inputs": {
          "from": "@variables('lines')",
          "select": "@item()?['contentData']?['lineNo']"
        },
        "runAfter": {
          "Until_group_complete": [
            "Succeeded",
            "Failed",
            "TimedOut"
          ]
        }
      },
      "Write_aggregate": {
        "type": "ServiceProvider",
        "inputs": {
          "parameters": {
            "databaseId": "msgpat",
            "containerId": "items",
            "item": {
              "id": "@{first(triggerBody())?['sessionId']}-agg",
              "pk": "@{first(triggerBody())?['sessionId']}",
              "pattern": "9a-group-literal",
              "docType": "aggregate",
              "orderId": "@{first(triggerBody())?['sessionId']}",
              "expected": "@variables('expected')",
              "received": "@length(variables('lines'))",
              "lineNos": "@body('Select_line_numbers')",
              "firstSentAtUtc": "@{first(triggerBody())?['contentData']?['sentAtUtc']}",
              "runId": "@{workflow()?['run']?['name']}",
              "processedAtUtc": "@{utcNow()}"
            },
            "isUpsert": true
          },
          "serviceProviderConfiguration": {
            "connectionName": "cosmos",
            "operationId": "CreateOrUpdateDocument",
            "serviceProviderId": "/serviceProviders/AzureCosmosDB"
          }
        },
        "runAfter": {
          "Select_line_numbers": [
            "Succeeded"
          ]
        }
      },
      "Close_session": {
        "type": "ServiceProvider",
        "inputs": {
          "parameters": {
            "queueName": "orders-literal",
            "sessionId": "@first(triggerBody())?['sessionId']"
          },
          "serviceProviderConfiguration": {
            "connectionName": "serviceBus",
            "operationId": "closeQueueSession",
            "serviceProviderId": "/serviceProviders/serviceBus"
          }
        },
        "runAfter": {
          "Write_aggregate": [
            "Succeeded",
            "Failed",
            "TimedOut",
            "Skipped"
          ]
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}
