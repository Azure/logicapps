{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "When_messages_are_available": {
        "type": "ServiceProvider",
        "inputs": {
          "parameters": {
            "queueName": "orders",
            "isSessionsEnabled": false,
            "maxMessageBatchSize": 50
          },
          "serviceProviderConfiguration": {
            "connectionName": "serviceBus",
            "operationId": "receiveQueueMessages",
            "serviceProviderId": "/serviceProviders/serviceBus"
          }
        }
      }
    },
    "actions": {
      "For_each_message": {
        "type": "Foreach",
        "foreach": "@triggerOutputs()?['body']",
        "runtimeConfiguration": {
          "concurrency": {
            "repetitions": 50
          }
        },
        "actions": {
          "Arrived": {
            "type": "Compose",
            "inputs": "@utcNow()",
            "runAfter": {}
          },
          "Apply_if_newer": {
            "type": "Until",
            "expression": "@not(equals(outputs('Outcome'), 'retry'))",
            "limit": {
              "count": 10,
              "timeout": "PT2M"
            },
            "runAfter": {
              "Arrived": [
                "Succeeded"
              ]
            },
            "actions": {
              "Read_latest": {
                "type": "ServiceProvider",
                "runAfter": {},
                "inputs": {
                  "parameters": {
                    "databaseId": "msgpat",
                    "containerId": "items",
                    "itemId": "latest-@{items('For_each_message')?['contentData']?['key']}",
                    "partitionKey": "@{items('For_each_message')?['contentData']?['key']}"
                  },
                  "serviceProviderConfiguration": {
                    "connectionName": "cosmos",
                    "operationId": "ReadDocument",
                    "serviceProviderId": "/serviceProviders/AzureCosmosDB"
                  }
                }
              },
              "Create_latest": {
                "type": "ServiceProvider",
                "runAfter": {
                  "Read_latest": [
                    "Failed"
                  ]
                },
                "inputs": {
                  "parameters": {
                    "databaseId": "msgpat",
                    "containerId": "items",
                    "item": {
                      "id": "latest-@{items('For_each_message')?['contentData']?['key']}",
                      "pk": "@{items('For_each_message')?['contentData']?['key']}",
                      "pattern": "6b-latest-wins",
                      "docType": "latest",
                      "key": "@{items('For_each_message')?['contentData']?['key']}",
                      "seq": "@items('For_each_message')?['contentData']?['seq']",
                      "messageId": "@{items('For_each_message')?['messageId']}",
                      "status": "@{items('For_each_message')?['contentData']?['status']}",
                      "updatedAtUtc": "@{utcNow()}",
                      "runId": "@{workflow()?['run']?['name']}"
                    },
                    "isUpsert": false
                  },
                  "serviceProviderConfiguration": {
                    "connectionName": "cosmos",
                    "operationId": "CreateOrUpdateDocument",
                    "serviceProviderId": "/serviceProviders/AzureCosmosDB"
                  }
                }
              },
              "Is_newer": {
                "type": "If",
                "runAfter": {
                  "Read_latest": [
                    "Succeeded"
                  ]
                },
                "expression": {
                  "and": [
                    {
                      "greater": [
                        "@int(items('For_each_message')?['contentData']?['seq'])",
                        "@int(coalesce(body('Read_latest')?['content']?['seq'], 0))"
                      ]
                    }
                  ]
                },
                "actions": {
                  "Replace_latest": {
                    "type": "ServiceProvider",
                    "runAfter": {},
                    "inputs": {
                      "parameters": {
                        "databaseId": "msgpat",
                        "containerId": "items",
                        "item": {
                          "id": "latest-@{items('For_each_message')?['contentData']?['key']}",
                          "pk": "@{items('For_each_message')?['contentData']?['key']}",
                          "pattern": "6b-latest-wins",
                          "docType": "latest",
                          "key": "@{items('For_each_message')?['contentData']?['key']}",
                          "seq": "@items('For_each_message')?['contentData']?['seq']",
                          "messageId": "@{items('For_each_message')?['messageId']}",
                          "status": "@{items('For_each_message')?['contentData']?['status']}",
                          "updatedAtUtc": "@{utcNow()}",
                          "runId": "@{workflow()?['run']?['name']}"
                        },
                        "isUpsert": true,
                        "partitionKey": "@{items('For_each_message')?['contentData']?['key']}",
                        "etag": "@{body('Read_latest')?['eTag']}"
                      },
                      "serviceProviderConfiguration": {
                        "connectionName": "cosmos",
                        "operationId": "CreateOrUpdateDocument",
                        "serviceProviderId": "/serviceProviders/AzureCosmosDB"
                      }
                    }
                  }
                },
                "else": {
                  "actions": {}
                }
              },
              "Attempt": {
                "type": "Compose",
                "inputs": "@add(iterationIndexes('Apply_if_newer'), 1)",
                "runAfter": {
                  "Create_latest": [
                    "Succeeded",
                    "Failed",
                    "Skipped"
                  ],
                  "Is_newer": [
                    "Succeeded",
                    "Failed",
                    "Skipped"
                  ]
                }
              },
              "Outcome": {
                "type": "Compose",
                "inputs": "@if(equals(actions('Create_latest')?['status'], 'Succeeded'), 'created', if(equals(actions('Replace_latest')?['status'], 'Succeeded'), 'applied', if(equals(actions('Read_latest')?['status'], 'Succeeded'), if(greater(int(items('For_each_message')?['contentData']?['seq']), int(coalesce(body('Read_latest')?['content']?['seq'], 0))), 'retry', 'stale'), 'retry')))",
                "runAfter": {
                  "Attempt": [
                    "Succeeded"
                  ]
                }
              }
            }
          },
          "Write_arrival": {
            "type": "ServiceProvider",
            "runAfter": {
              "Apply_if_newer": [
                "Succeeded",
                "Failed",
                "TimedOut"
              ]
            },
            "inputs": {
              "parameters": {
                "databaseId": "msgpat",
                "containerId": "items",
                "isUpsert": true,
                "item": {
                  "id": "arr-@{items('For_each_message')?['contentData']?['key']}-@{items('For_each_message')?['contentData']?['seq']}",
                  "pk": "@{items('For_each_message')?['contentData']?['key']}",
                  "pattern": "6b-latest-wins",
                  "docType": "arrival",
                  "key": "@{items('For_each_message')?['contentData']?['key']}",
                  "seq": "@items('For_each_message')?['contentData']?['seq']",
                  "messageId": "@{items('For_each_message')?['messageId']}",
                  "deliveryCount": "@items('For_each_message')?['deliveryCount']",
                  "sentAtUtc": "@{items('For_each_message')?['contentData']?['sentAtUtc']}",
                  "enqueuedTimeUtc": "@{items('For_each_message')?['enqueuedTimeUtc']}",
                  "arrivedAtUtc": "@{outputs('Arrived')}",
                  "outcome": "@{outputs('Outcome')}",
                  "attempts": "@outputs('Attempt')",
                  "runId": "@{workflow()?['run']?['name']}",
                  "processedAtUtc": "@{utcNow()}"
                }
              },
              "serviceProviderConfiguration": {
                "connectionName": "cosmos",
                "operationId": "CreateOrUpdateDocument",
                "serviceProviderId": "/serviceProviders/AzureCosmosDB"
              }
            },
            "trackedProperties": {
              "key": "@{items('For_each_message')?['contentData']?['key']}",
              "seq": "@{items('For_each_message')?['contentData']?['seq']}",
              "outcome": "@{action()?['inputs']?['parameters']?['item']?['outcome']}",
              "pattern": "6b-latest-wins"
            }
          }
        },
        "runAfter": {}
      }
    },
    "outputs": {}
  },
  "kind": "Stateless"
}
