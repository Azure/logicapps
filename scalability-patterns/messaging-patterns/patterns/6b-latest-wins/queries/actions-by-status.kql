// Parameters: replace {{startUtc}}, {{endUtc}} and {{workflowName}} (Run-Queries.ps1 in this folder does this).
let startTime = datetime({{startUtc}});
let endTime = datetime({{endUtc}});
let workflow = '{{workflowName}}';// Action and trigger outcomes: count per name, status and result code. Shows Cosmos 404/409/412 conflicts on the conditional write.
requests | where timestamp between (startTime .. endTime) | where customDimensions.Category in ('Workflow.Operations.Actions', 'Workflow.Operations.Triggers') | where tostring(parse_json(tostring(customDimensions.resource)).workflowName) == workflow | extend actionName = coalesce(tostring(parse_json(tostring(customDimensions.resource)).actionName), tostring(parse_json(tostring(customDimensions.resource)).triggerName), name), status = tostring(customDimensions.prop__status), code = tostring(customDimensions.prop__statusCode) | summarize count() by actionName, status, code, resultCode, success | order by actionName asc, count_ desc
