// Parameters: replace {{startUtc}}, {{endUtc}} and {{workflowName}} (tools\Run-Queries.ps1 does this).
let startTime = datetime({{startUtc}});
let endTime = datetime({{endUtc}});
let workflow = '{{workflowName}}';
// Completion of the backlog: first producer send to the last finished item run, with end-to-end
// latency (send to finish) and queue-to-finish latency (enqueue to finish) percentiles.
requests
| where timestamp between (startTime .. endTime)
| where customDimensions.Category == 'Workflow.Operations.Actions'
| extend tp = parse_json(tostring(customDimensions.trackedProperties))
| where isnotempty(tp.sentAtUtc)
| where tostring(parse_json(tostring(customDimensions.resource)).workflowName) == workflow
| extend messageId = tostring(tp.messageId), sentAt = todatetime(tp.sentAtUtc), enqueuedAt = todatetime(tp.enqueuedTimeUtc)
| extend finishedAt = timestamp + totimespan(duration * 10000)
| summarize finishedAt = max(finishedAt), sentAt = min(sentAt), enqueuedAt = min(enqueuedAt) by messageId
| extend e2eMs = datetime_diff('millisecond', finishedAt, sentAt)
| summarize messages = count(), firstSent = min(sentAt), lastSent = max(sentAt), firstFinished = min(finishedAt), lastFinished = max(finishedAt),
    e2eP50 = percentile(e2eMs, 50), e2eP95 = percentile(e2eMs, 95), e2eMax = max(e2eMs)
| extend completionMinutes = round(datetime_diff('second', lastFinished, firstSent) / 60.0, 2),
    processingMinutes = round(datetime_diff('second', lastFinished, firstFinished) / 60.0, 2)
