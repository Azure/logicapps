{
  "$comment": "Pattern 3a overrides for infra/main.bicep and the run loop. One 3,000-message drop sent in 1 minute must finish within a 10-minute deadline. See README.md.",
  "location": "westus3",
  "fallbackLocation": "swedencentral",
  "planSku": "WS1",
  "maximumElasticWorkerCount": 20,
  "minimumElasticInstanceCount": 5,
  "serviceBusSku": "Standard",
  "queues": [
    {
      "name": "orders",
      "lockDuration": "PT5M",
      "maxDeliveryCount": 10,
      "maxSizeInMegabytes": 5120
    }
  ],
  "topics": [],
  "extraAppSettings": {},
  "hostSettings": {
    "Runtime.Trigger.MaximumRunConcurrency": "400",
    "Runtime.Trigger.MaximumWaitingRuns": "1000"
  },
  "loadTest": {
    "queueName": "orders",
    "engineInstances": 1,
    "users": 10,
    "spawnRate": 10,
    "batchSize": 10,
    "batchesPerUserPerSecond": 0.5,
    "durationMinutes": 1
  },
  "drainMinutes": 10,
  "measurement": {
    "workflowName": "orders-deadline",
    "deadlineMinutes": 10
  }
}
