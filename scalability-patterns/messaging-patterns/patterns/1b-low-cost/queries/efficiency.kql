// Parameters: replace {{startUtc}}, {{endUtc}} and {{workflowName}} before running.
let startTime = datetime({{startUtc}});
let endTime = datetime({{endUtc}});
let workflow = '{{workflowName}}';
// Efficiency: runs and action executions per message for the batch workflow and the shared child.
// A message counts as processed when its Process_order action finished in the window.
let messages = toscalar(requests
| where timestamp between (startTime .. endTime)
| where customDimensions.Category == 'Workflow.Operations.Actions'
| where tostring(parse_json(tostring(customDimensions.resource)).workflowName) == workflow
| where tostring(parse_json(tostring(customDimensions.resource)).actionName) == 'Process_order'
| summarize dcount(tostring(parse_json(tostring(customDimensions.trackedProperties)).messageId)));
let runs = traces
| where timestamp between (startTime .. endTime)
| where customDimensions.Category == 'Workflow.Operations.Runs' and customDimensions.EventName == 'WorkflowRunEnd'
| summarize runsEnded = count() by workflowName = tostring(parse_json(tostring(customDimensions.resource)).workflowName);
let actions = requests
| where timestamp between (startTime .. endTime)
| where customDimensions.Category == 'Workflow.Operations.Actions'
| summarize actionExecutions = count() by workflowName = tostring(parse_json(tostring(customDimensions.resource)).workflowName);
let triggers = requests
| where timestamp between (startTime .. endTime)
| where customDimensions.Category == 'Workflow.Operations.Triggers'
| summarize triggerExecutions = count() by workflowName = tostring(parse_json(tostring(customDimensions.resource)).workflowName);
runs
| join kind=fullouter actions on workflowName
| join kind=fullouter triggers on workflowName
| extend workflowName = coalesce(workflowName, workflowName1, workflowName2)
| project workflowName, runsEnded, actionExecutions, triggerExecutions, messagesProcessed = messages,
    runsPerMessage = round(todouble(runsEnded) / messages, 4),
    actionsPerMessage = round(todouble(actionExecutions) / messages, 3)
