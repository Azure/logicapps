// Parameters: replace {{startUtc}}, {{endUtc}} and {{workflowName}} before running.
let startTime = datetime({{startUtc}});
let endTime = datetime({{endUtc}});
let workflow = '{{workflowName}}';
// Messages processed per minute (Process_order completions) and batch runs started per minute.
requests
| where timestamp between (startTime .. endTime)
| where customDimensions.Category == 'Workflow.Operations.Actions'
| where tostring(parse_json(tostring(customDimensions.resource)).workflowName) == workflow
| extend actionName = tostring(parse_json(tostring(customDimensions.resource)).actionName)
| summarize messages = countif(actionName == 'Process_order'), batchRuns = dcountif(tostring(parse_json(tostring(customDimensions.resource)).runId), actionName == 'Process_order'),
    instances = dcount(cloud_RoleInstance) by minute = bin(timestamp, 1m)
| order by minute asc
