// Replace startTime and endTime with your run window (UTC) before you run this in Application Insights > Logs.
// Whole-run totals per workflow and run status.
let startTime = datetime(2026-01-01T00:00:00Z); let endTime = datetime(2026-01-01T01:00:00Z); traces | where timestamp between (startTime .. endTime) | where customDimensions.Category == 'Workflow.Operations.Runs' and customDimensions.EventName == 'WorkflowRunEnd' | extend workflowName = tostring(parse_json(tostring(customDimensions.resource)).workflowName), durationMs = todouble(customDimensions.prop__durationInMilliseconds), status = trim('"', tostring(customDimensions.status)) | summarize runs = count(), p50 = percentile(durationMs, 50), p95 = percentile(durationMs, 95), p99 = percentile(durationMs, 99), maxMs = max(durationMs) by workflowName, status | order by workflowName asc
