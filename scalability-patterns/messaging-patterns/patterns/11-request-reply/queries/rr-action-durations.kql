// Replace startTime and endTime with your run window (UTC) before you run this in Application Insights > Logs.
// Action duration percentiles per minute for the request-reply path (send, wait for reply, process, send reply).
let startTime = datetime(2026-01-01T00:00:00Z); let endTime = datetime(2026-01-01T01:00:00Z); requests | where timestamp between (startTime .. endTime) | where customDimensions.Category == 'Workflow.Operations.Actions' | extend workflowName = tostring(parse_json(tostring(customDimensions.resource)).workflowName) | where workflowName in ('rr-front','rr-back') | summarize count = count(), failed = countif(success == false), p50 = percentile(duration, 50), p95 = percentile(duration, 95), p99 = percentile(duration, 99) by minute = bin(timestamp, 1m), workflowName, action = name | order by minute asc, workflowName asc, action asc
