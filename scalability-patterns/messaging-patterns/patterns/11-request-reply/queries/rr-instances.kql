// Replace startTime and endTime with your run window (UTC) before you run this in Application Insights > Logs.
// Distinct host instances per minute, and which workflow each instance ran.
let startTime = datetime(2026-01-01T00:00:00Z); let endTime = datetime(2026-01-01T01:00:00Z); requests | where timestamp between (startTime .. endTime) | where customDimensions.Category == 'Workflow.Operations.Actions' | extend workflowName = tostring(parse_json(tostring(customDimensions.resource)).workflowName) | summarize instances = dcount(cloud_RoleInstance), actions = count() by minute = bin(timestamp, 1m), workflowName | order by minute asc
