// Parameters: replace {{startUtc}}, {{endUtc}} and {{workflowName}} (tools\Run-Queries.ps1 does this).
let startTime = datetime({{startUtc}});
let endTime = datetime({{endUtc}});
let workflow = '{{workflowName}}';// Batch releases per second (one orders-receiver Process_batch action per release) and items started per second (process-batch-item Process_order actions). A tracked property on Process_batch came back empty, so items per release is items divided by releases. Empty for design A.
let rel = requests | where timestamp between (startTime .. endTime) | where customDimensions.Category == 'Workflow.Operations.Actions' | where tostring(parse_json(tostring(customDimensions.resource)).workflowName) == 'orders-receiver' | where tostring(parse_json(tostring(customDimensions.resource)).actionName) == 'Process_batch' | summarize releases = count(), p50ReleaseActionMs = percentile(duration, 50) by sec = bin(timestamp, 1s); let itm = requests | where timestamp between (startTime .. endTime) | where customDimensions.Category == 'Workflow.Operations.Actions' | where tostring(parse_json(tostring(customDimensions.resource)).workflowName) == 'process-batch-item' | where tostring(parse_json(tostring(customDimensions.resource)).actionName) == 'Process_order' | summarize items = count() by sec = bin(timestamp, 1s); rel | join kind=fullouter itm on sec | extend sec = coalesce(sec, sec1), releases = coalesce(releases, 0), items = coalesce(items, 0) | project sec, releases, items, p50ReleaseActionMs | order by sec asc
