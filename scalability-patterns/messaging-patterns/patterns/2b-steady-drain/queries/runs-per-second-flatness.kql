// Parameters: replace {{startUtc}}, {{endUtc}} and {{workflowName}} (Run-Queries.ps1 in this folder does this).
let startTime = datetime({{startUtc}});
let endTime = datetime({{endUtc}});
let workflow = '{{workflowName}}';
// Entry-workflow runs per 10 s bucket while work is flowing, with mean, stdev and coefficient of variation.
traces
| where timestamp between (startTime .. endTime)
| where customDimensions.Category == 'Workflow.Operations.Runs' and customDimensions.EventName == 'WorkflowRunEnd'
| where tostring(parse_json(tostring(customDimensions.resource)).workflowName) == workflow
| summarize runs = count() by bucket = bin(timestamp, 10s)
| extend runsPerSecond = runs / 10.0
| summarize buckets = count(), firstBucket = min(bucket), lastBucket = max(bucket), meanRps = round(avg(runsPerSecond), 2), stdevRps = round(stdev(runsPerSecond), 2), p10Rps = percentile(runsPerSecond, 10), p90Rps = percentile(runsPerSecond, 90), peakRps = max(runsPerSecond)
| extend cv = round(stdevRps / meanRps, 3)
