// Latency percentiles per workflow, split into messages sent after a send gap of more than 120 s (after idle) and the rest.
let startTime = datetime({{startUtc}});
let endTime = datetime({{endUtc}});
let perMessage = requests
| where timestamp between (startTime .. endTime)
| where customDimensions.Category == 'Workflow.Operations.Actions'
| extend tp = parse_json(tostring(customDimensions.trackedProperties))
| where isnotempty(tp.sentAtUtc)
| extend workflowName = tostring(parse_json(tostring(customDimensions.resource)).workflowName)
| where workflowName in ('trickle-stateful', 'trickle-stateless')
| extend messageId = tostring(tp.messageId), sentAt = todatetime(tp.sentAtUtc), enqueuedAt = todatetime(tp.enqueuedTimeUtc)
| extend finishedAt = timestamp + totimespan(duration * 10000)
| summarize finishedAt = max(finishedAt), sentAt = min(sentAt), enqueuedAt = min(enqueuedAt), instance = any(cloud_RoleInstance) by workflowName, messageId
| extend e2eMs = datetime_diff('millisecond', finishedAt, sentAt), fromEnqueueMs = datetime_diff('millisecond', finishedAt, enqueuedAt)
| order by workflowName asc, sentAt asc
| extend prevSent = prev(sentAt), prevWorkflow = prev(workflowName)
| extend gapSincePrevSendSec = iff(prevWorkflow == workflowName, datetime_diff('millisecond', sentAt, prevSent) / 1000.0, real(null));perMessage
| extend bucket = iff(isnull(gapSincePrevSendSec) or gapSincePrevSendSec > 120, 'after-idle (>120s gap or first)', 'steady (<=120s gap)')
| summarize messages = count(), p50 = percentile(e2eMs, 50), p95 = percentile(e2eMs, 95), maxMs = max(e2eMs), minMs = min(e2eMs),
    enqueueP50 = percentile(fromEnqueueMs, 50), enqueueP95 = percentile(fromEnqueueMs, 95) by workflowName, bucket
| union (perMessage | summarize messages = count(), p50 = percentile(e2eMs, 50), p95 = percentile(e2eMs, 95), maxMs = max(e2eMs), minMs = min(e2eMs),
    enqueueP50 = percentile(fromEnqueueMs, 50), enqueueP95 = percentile(fromEnqueueMs, 95) by workflowName | extend bucket = 'all')
| order by workflowName asc, bucket asc
