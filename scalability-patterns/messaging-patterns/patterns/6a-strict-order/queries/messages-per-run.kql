// Parameters: replace {{startUtc}}, {{endUtc}} and {{workflowName}} (Run-Queries.ps1 in this folder does this).
let startTime = datetime({{startUtc}});
let endTime = datetime({{endUtc}});
let workflow = '{{workflowName}}';// Messages processed per run (one run handles one session batch): distribution of Upsert_order count per run.
requests | where timestamp between (startTime .. endTime) | where customDimensions.Category == 'Workflow.Operations.Actions' | where tostring(parse_json(tostring(customDimensions.resource)).workflowName) == workflow | where name endswith 'Upsert_order' or tostring(parse_json(tostring(customDimensions.resource)).actionName) == 'Upsert_order' | summarize messages = count() by runId = tostring(parse_json(tostring(customDimensions.resource)).runId) | summarize runs = count(), avgMessagesPerRun = round(avg(messages), 2), p50 = percentile(messages, 50), p95 = percentile(messages, 95), maxMessages = max(messages)
