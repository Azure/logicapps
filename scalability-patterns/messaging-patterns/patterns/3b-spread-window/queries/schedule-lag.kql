// Parameters: replace {{startUtc}}, {{endUtc}} and {{workflowName}} (tools\Run-Queries.ps1 does this).
let startTime = datetime({{startUtc}});
let endTime = datetime({{endUtc}});
let workflow = '{{workflowName}}';
// Schedule adherence: per minute, how many messages Service Bus released (enqueuedTimeUtc) and
// how far each run finished after its ScheduledEnqueueTimeUtc (scheduledForUtc). A growing lag
// means the plan cannot keep up with the release rate.
requests
| where timestamp between (startTime .. endTime)
| where customDimensions.Category == 'Workflow.Operations.Actions'
| extend tp = parse_json(tostring(customDimensions.trackedProperties))
| where isnotempty(tp.scheduledForUtc)
| where tostring(parse_json(tostring(customDimensions.resource)).workflowName) == workflow
| extend messageId = tostring(tp.messageId), scheduledFor = todatetime(tp.scheduledForUtc), enqueuedAt = todatetime(tp.enqueuedTimeUtc)
| extend finishedAt = timestamp + totimespan(duration * 10000)
| summarize finishedAt = max(finishedAt), scheduledFor = min(scheduledFor), enqueuedAt = min(enqueuedAt) by messageId
| extend lagMs = datetime_diff('millisecond', finishedAt, scheduledFor), releaseSkewMs = datetime_diff('millisecond', enqueuedAt, scheduledFor)
| summarize released = count(), lagP50 = percentile(lagMs, 50), lagP95 = percentile(lagMs, 95), lagMax = max(lagMs), releaseSkewP50 = percentile(releaseSkewMs, 50)
    by minute = bin(scheduledFor, 1m)
| order by minute asc
