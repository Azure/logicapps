// Parameters: replace {{startUtc}}, {{endUtc}} and {{workflowName}} (tools\Run-Queries.ps1 does this).
let startTime = datetime({{startUtc}});
let endTime = datetime({{endUtc}});
let workflow = '{{workflowName}}';// Latency of each message: queue wait (enqueued to action start), action time, and end to end (sent to action end).
requests | where timestamp between (startTime .. endTime) | where customDimensions.Category == 'Workflow.Operations.Actions' | where tostring(parse_json(tostring(customDimensions.resource)).workflowName) == workflow | where tostring(parse_json(tostring(customDimensions.resource)).actionName) == 'Process_order' | extend tp = parse_json(tostring(customDimensions.trackedProperties)), endAt = timestamp + totimespan(duration * 10000) | extend waitMs = datetime_diff('millisecond', timestamp, todatetime(tp.enqueuedTimeUtc)), e2eMs = datetime_diff('millisecond', endAt, todatetime(tp.sentAtUtc)) | summarize actions = count(), succeeded = countif(resultCode == 'Succeeded'), distinctMessages = dcount(tostring(tp.messageId)), p50WaitMs = percentile(waitMs, 50), p95WaitMs = percentile(waitMs, 95), p50ActionMs = percentile(duration, 50), p95ActionMs = percentile(duration, 95), p50E2eMs = percentile(e2eMs, 50), p95E2eMs = percentile(e2eMs, 95), p99E2eMs = percentile(e2eMs, 99), maxE2eMs = max(e2eMs)
