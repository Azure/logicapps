// Parameters: replace {{startUtc}}, {{endUtc}} and {{workflowName}} (tools\Run-Queries.ps1 does this).
let startTime = datetime({{startUtc}});
let endTime = datetime({{endUtc}});
let workflow = '{{workflowName}}';
// Runs in flight, counted exactly: each run adds 1 at its start (end minus duration) and removes 1 at its end. A running sum over these events, ordered by time with ends before starts at the same instant, gives the true count at every instant. Each second reports the peak count seen in that second.
let runs = traces | where timestamp between (startTime .. endTime) | where customDimensions.Category == 'Workflow.Operations.Runs' and customDimensions.EventName == 'WorkflowRunEnd' | where tostring(parse_json(tostring(customDimensions.resource)).workflowName) == workflow | extend durationMs = todouble(customDimensions.prop__durationInMilliseconds) | extend runEnd = timestamp, runStart = timestamp - totimespan(durationMs * 10000), instance = cloud_RoleInstance;
let events = union (runs | project t = runStart, d = 1, instance), (runs | project t = runEnd, d = -1, instance);
let appSweep = events | order by t asc, d asc | extend inFlight = row_cumsum(d);
let instSweep = events | order by instance asc, t asc, d asc | extend inFlight = row_cumsum(d, instance != prev(instance));
let app = appSweep | summarize appInFlight = max(inFlight) by sec = bin(t, 1s);
let inst = instSweep | summarize instancePeak = max(inFlight) by sec = bin(t, 1s), instance | summarize maxInstanceInFlight = max(instancePeak), activeInstances = dcount(instance) by sec;
app | join kind=fullouter inst on sec | project sec = coalesce(sec, sec1), appInFlight, maxInstanceInFlight, activeInstances | order by sec asc
