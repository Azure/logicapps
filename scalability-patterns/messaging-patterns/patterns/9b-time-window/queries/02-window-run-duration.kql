// Parameters: replace {{startUtc}}, {{endUtc}} and {{workflowName}} (Run-Queries.ps1 in this folder does this).
let startTime = datetime({{startUtc}});
let endTime = datetime({{endUtc}});
let workflow = '{{workflowName}}';
// Window runs: duration distribution (run start to end) and failures.
traces
| where timestamp between (startTime .. endTime)
| where customDimensions.Category == 'Workflow.Operations.Runs'
| where customDimensions.EventName == 'WorkflowRunEnd'
| where tostring(parse_json(tostring(customDimensions.resource)).workflowName) == workflow
| extend durationMs = todouble(customDimensions.prop__durationInMilliseconds)
| extend status = tostring(customDimensions.prop__status)
| summarize runs = count(), failed = countif(status == 'Failed'), p50Seconds = percentile(durationMs, 50) / 1000.0, p95Seconds = percentile(durationMs, 95) / 1000.0, maxSeconds = max(durationMs) / 1000.0
