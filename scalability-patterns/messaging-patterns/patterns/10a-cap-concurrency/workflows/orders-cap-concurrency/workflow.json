{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "When_messages_are_available_in_orders": {
        "type": "ServiceProvider",
        "inputs": {
          "parameters": {
            "queueName": "orders",
            "isSessionsEnabled": false,
            "maxMessageBatchSize": 50
          },
          "serviceProviderConfiguration": {
            "connectionName": "serviceBus",
            "operationId": "receiveQueueMessages",
            "serviceProviderId": "/serviceProviders/serviceBus"
          }
        },
        "splitOn": "@triggerOutputs()?['body']",
        "runtimeConfiguration": {
          "concurrency": {
            "runs": 10,
            "maximumWaitingRuns": 20
          }
        }
      }
    },
    "actions": {
      "Upsert_limited": {
        "type": "ServiceProvider",
        "inputs": {
          "parameters": {
            "databaseId": "limited",
            "containerId": "items",
            "item": {
              "id": "@{triggerBody()?['messageId']}",
              "pk": "@{triggerBody()?['messageId']}",
              "pattern": "10a-cap-concurrency",
              "messageId": "@{triggerBody()?['messageId']}",
              "sentAtUtc": "@{triggerBody()?['contentData']?['sentAtUtc']}",
              "deliveryCount": "@triggerBody()?['deliveryCount']",
              "processedAtUtc": "@{utcNow()}",
                  "padding": "@range(0, 400)"
            },
            "isUpsert": true
          },
          "serviceProviderConfiguration": {
            "connectionName": "cosmosLimited",
            "operationId": "CreateOrUpdateDocument",
            "serviceProviderId": "/serviceProviders/AzureCosmosDB"
          }
        },
        "runAfter": {},
        "trackedProperties": {
          "messageId": "@{triggerBody()?['messageId']}",
          "enqueuedTimeUtc": "@{triggerBody()?['enqueuedTimeUtc']}",
          "sentAtUtc": "@{triggerBody()?['contentData']?['sentAtUtc']}",
          "deliveryCount": "@{triggerBody()?['deliveryCount']}",
          "pattern": "10a-cap-concurrency"
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}

