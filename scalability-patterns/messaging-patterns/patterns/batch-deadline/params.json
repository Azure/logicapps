{
  "$comment": "Batch deadline: a known backlog of 100,000 orders must be processed within 10 minutes. Two ingress workflows compete on the queue and feed two batch receivers; each receiver releases at most 100 messages every second (ceiling 200 msg/s against the 167 msg/s required). See README.md.",
  "location": "westus3",
  "fallbackLocation": "swedencentral",
  "planSku": "WS1",
  "maximumElasticWorkerCount": 20,
  "minimumElasticInstanceCount": 2,
  "functionsRuntimeScaleMonitoringEnabled": true,
  "serviceBusSku": "Standard",
  "queues": [
    {
      "name": "orders",
      "lockDuration": "PT5M",
      "maxDeliveryCount": 10,
      "maxSizeInMegabytes": 5120
    }
  ],
  "topics": [],
  "extraAppSettings": {},
  "hostSettings": {
    "Runtime.BatchConfiguration.MinimumRecurrenceInterval": "00:00:01",
    "Runtime.BatchConfiguration.AllowMessageCountInRecurrence": "true",
    "Runtime.FlowBatchTriggerReleaseJob.ExecutionInterval": "00:00:00.100",
    "Runtime.FlowBatchTriggerPushJob.ExecutionInterval": "00:00:01",
    "Runtime.FlowBatchTriggerPushJob.DisableSafetyLimitsRelease": "true"
  },
  "loadTest": {
    "queueName": "orders",
    "engineInstances": 1,
    "users": 20,
    "spawnRate": 20,
    "batchSize": 100,
    "batchesPerUserPerSecond": 1,
    "durationMinutes": 1
  },
  "drainMinutes": 15,
  "measurement": {
    "workflowName": "process-batch-item",
    "backlogMessages": 100000,
    "deadlineMinutes": 10
  }
}
