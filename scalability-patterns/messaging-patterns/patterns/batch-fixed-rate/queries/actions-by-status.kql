// Parameters: replace {{startUtc}}, {{endUtc}} and {{workflowName}} (Run-Queries.ps1 in this folder does this).
let startTime = datetime({{startUtc}});
let endTime = datetime({{endUtc}});
let workflow = '{{workflowName}}';
// Count of action and trigger executions by workflow, name and status, for all four workflows in the pattern.
requests | where timestamp between (startTime .. endTime) | where customDimensions.Category in ('Workflow.Operations.Actions', 'Workflow.Operations.Triggers') | extend wf = tostring(parse_json(tostring(customDimensions.resource)).workflowName) | where wf in ('orders-ingress', 'orders-receiver', 'process-batch-item', 'process-order') | extend actionName = coalesce(tostring(parse_json(tostring(customDimensions.resource)).actionName), tostring(parse_json(tostring(customDimensions.resource)).triggerName), name), code = tostring(parse_json(tostring(customDimensions.error)).code) | summarize count = count(), p50Ms = percentile(duration, 50), p95Ms = percentile(duration, 95), maxMs = max(duration) by wf, actionName, status = resultCode, code | order by wf asc, actionName asc, ['count'] desc
