// Parameters: replace {{startUtc}}, {{endUtc}}, {{workflowName}} (urgent) and {{lowWorkflowName}} (bulk). Run-Queries.ps1 in this pattern does this.
let startTime = datetime({{startUtc}});
let endTime = datetime({{endUtc}});
let high = '{{workflowName}}';
let low = '{{lowWorkflowName}}';
// Urgent end-to-end latency (send to child workflow done) by phase: before the bulk burst, while bulk work is in the system, and after it drains.
let e2e = requests | where timestamp between (startTime .. endTime) | where customDimensions.Category == 'Workflow.Operations.Actions' | extend tp = parse_json(tostring(customDimensions.trackedProperties)) | where isnotempty(tp.sentAtUtc) | extend wf = tostring(parse_json(tostring(customDimensions.resource)).workflowName) | where wf in (high, low) | summarize finishedAt = max(timestamp + totimespan(duration * 10000)), sentAt = min(todatetime(tp.sentAtUtc)) by wf, messageId = tostring(tp.messageId) | where sentAt >= startTime | extend e2eMs = datetime_diff('millisecond', finishedAt, sentAt);
let burstStart = toscalar(e2e | where wf == low | summarize min(sentAt));
let burstEnd = toscalar(e2e | where wf == low | summarize max(finishedAt));
e2e | where wf == high | extend phase = case(isnull(burstStart) or sentAt < burstStart, '1-before', sentAt <= burstEnd, '2-during', '3-after') | summarize messages = count(), p50Ms = percentile(e2eMs, 50), p95Ms = percentile(e2eMs, 95), p99Ms = percentile(e2eMs, 99), maxMs = max(e2eMs), firstSent = min(sentAt), lastSent = max(sentAt) by phase | order by phase asc
