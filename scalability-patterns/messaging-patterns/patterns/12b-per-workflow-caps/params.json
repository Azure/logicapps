{
  "$comment": "Pattern 12b: urgent and bulk workflows in one Logic App. Trigger concurrency caps the bulk workflow. orders-low-nocap is the uncapped baseline, disabled by default (tools\\Set-Variant.ps1). See README.md.",
  "location": "westus3",
  "fallbackLocation": "swedencentral",
  "planSku": "WS1",
  "maximumElasticWorkerCount": 20,
  "minimumElasticInstanceCount": 1,
  "serviceBusSku": "Standard",
  "queues": [
    { "name": "orders-high", "lockDuration": "PT5M", "maxDeliveryCount": 10, "maxSizeInMegabytes": 5120 },
    { "name": "orders-low", "lockDuration": "PT5M", "maxDeliveryCount": 10, "maxSizeInMegabytes": 5120 }
  ],
  "topics": [],
  "extraAppSettings": {
    "Workflows.orders-low-nocap.FlowState": "Disabled"
  },
  "hostSettings": {},
  "loadTest": {
    "queueName": "orders-high",
    "engineInstances": 1,
    "users": 6,
    "spawnRate": 6,
    "batchSize": 2,
    "batchesPerUserPerSecond": 1,
    "durationMinutes": 10,
    "env": {
      "SB_QUEUE_LOW": "orders-low",
      "HIGH_USERS": "1",
      "LOW_USERS": "5",
      "LOW_BATCH_SIZE": "50",
      "BURST_START_SEC": "180",
      "BURST_MESSAGES": "12000",
      "SMOKE_BURST_MESSAGES": "500"
    }
  },
  "drainMinutes": 5,
  "measurement": {
    "workflowName": "orders-high",
    "lowWorkflowName": "orders-low"
  }
}
