{
  "$comment": "Pattern 7 overrides for infra/main.bicep and the run loop. Two queues: orders-early (settle early, Stateful run holds the state) and orders-lock (peek-lock, lock renewed in the run). See README.md.",
  "location": "westus3",
  "fallbackLocation": "swedencentral",
  "planSku": "WS1",
  "maximumElasticWorkerCount": 20,
  "minimumElasticInstanceCount": 1,
  "serviceBusSku": "Standard",
  "queues": [
    {
      "name": "orders-early",
      "lockDuration": "PT5M",
      "maxDeliveryCount": 10,
      "maxSizeInMegabytes": 5120
    },
    {
      "name": "orders-lock",
      "lockDuration": "PT1M",
      "maxDeliveryCount": 10,
      "maxSizeInMegabytes": 5120
    }
  ],
  "topics": [],
  "extraAppSettings": {},
  "hostSettings": {},
  "loadTest": {
    "queueName": "orders-early",
    "engineInstances": 1,
    "users": 1,
    "spawnRate": 1,
    "batchSize": 2,
    "batchesPerUserPerSecond": 1,
    "durationMinutes": 5
  },
  "drainMinutes": 8,
  "measurement": {
    "workflowName": "long-running-settle-early"
  }
}
