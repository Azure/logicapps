{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "When_a_message_is_available_in_orders_lock_stateful_peek_lock": {
        "type": "ServiceProvider",
        "inputs": {
          "parameters": {
            "queueName": "orders-lock-stateful",
            "isSessionsEnabled": false,
            "maxMessageBatchSize": 20
          },
          "serviceProviderConfiguration": {
            "connectionName": "serviceBus",
            "operationId": "peekLockQueueMessages",
            "serviceProviderId": "/serviceProviders/serviceBus"
          }
        },
        "splitOn": "@triggerOutputs()?['body']"
      }
    },
    "actions": {
      "Initialize_processing_status": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "processingStatus",
              "type": "string",
              "value": "Running"
            }
          ]
        },
        "runAfter": {}
      },
      "Process_message": {
        "type": "Scope",
        "actions": {
          "Slow_call_1": {
            "type": "Http",
            "inputs": {
              "method": "POST",
              "uri": "@appsetting('SlowDownstreamUrl')",
              "body": {
                "seconds": 40
              }
            },
            "runAfter": {}
          },
          "Slow_call_2": {
            "type": "Http",
            "inputs": {
              "method": "POST",
              "uri": "@appsetting('SlowDownstreamUrl')",
              "body": {
                "seconds": 40
              }
            },
            "runAfter": {
              "Slow_call_1": [
                "Succeeded"
              ]
            }
          },
          "Slow_call_3": {
            "type": "Http",
            "inputs": {
              "method": "POST",
              "uri": "@appsetting('SlowDownstreamUrl')",
              "body": {
                "seconds": 40
              }
            },
            "runAfter": {
              "Slow_call_2": [
                "Succeeded"
              ]
            }
          },
          "Slow_call_4": {
            "type": "Http",
            "inputs": {
              "method": "POST",
              "uri": "@appsetting('SlowDownstreamUrl')",
              "body": {
                "seconds": 40
              }
            },
            "runAfter": {
              "Slow_call_3": [
                "Succeeded"
              ]
            }
          },
          "Process_order": {
            "type": "Workflow",
            "inputs": {
              "host": {
                "workflow": {
                  "id": "process-order"
                }
              },
              "body": {
                "messageId": "@{triggerBody()?['messageId']}",
                "pattern": "7-long-running",
                "deliveryCount": "@{triggerBody()?['deliveryCount']}",
                "enqueuedTimeUtc": "@{triggerBody()?['enqueuedTimeUtc']}",
                "order": "@triggerBody()?['contentData']"
              }
            },
            "trackedProperties": {
              "messageId": "@{action()?['inputs']?['body']?['messageId']}",
              "sentAtUtc": "@{action()?['inputs']?['body']?['order']?['sentAtUtc']}",
              "enqueuedTimeUtc": "@{action()?['inputs']?['body']?['enqueuedTimeUtc']}",
              "deliveryCount": "@{action()?['inputs']?['body']?['deliveryCount']}",
              "pattern": "7-long-running"
            },
            "runAfter": {
              "Slow_call_4": [
                "Succeeded"
              ]
            }
          }
        },
        "runAfter": {
          "Initialize_processing_status": [
            "Succeeded"
          ]
        }
      },
      "Set_processing_status": {
        "type": "SetVariable",
        "inputs": {
          "name": "processingStatus",
          "value": "@{if(equals(actions('Process_message')?['status'], 'Succeeded'), 'Succeeded', 'Failed')}"
        },
        "runAfter": {
          "Process_message": [
            "Succeeded",
            "Failed",
            "TimedOut",
            "Skipped"
          ]
        }
      },
      "Keep_lock_alive": {
        "type": "Until",
        "expression": "@not(equals(variables('processingStatus'), 'Running'))",
        "limit": {
          "count": 120,
          "timeout": "PT1H"
        },
        "actions": {
          "Wait_half_the_lock": {
            "type": "Wait",
            "inputs": {
              "interval": {
                "count": 30,
                "unit": "Second"
              }
            },
            "runAfter": {}
          },
          "Renew_lock": {
            "type": "ServiceProvider",
            "inputs": {
              "parameters": {
                "messageId": "@triggerBody()?['messageId']",
                "lockToken": "@triggerBody()?['lockToken']"
              },
              "serviceProviderConfiguration": {
                "connectionName": "serviceBus",
                "operationId": "renewLockMessage",
                "serviceProviderId": "/serviceProviders/serviceBus"
              }
            },
            "runAfter": {
              "Wait_half_the_lock": [
                "Succeeded"
              ]
            }
          }
        },
        "runAfter": {
          "Initialize_processing_status": [
            "Succeeded"
          ]
        }
      },
      "Settle_message": {
        "type": "If",
        "expression": {
          "and": [
            {
              "equals": [
                "@variables('processingStatus')",
                "Succeeded"
              ]
            }
          ]
        },
        "actions": {
          "Complete_message": {
            "type": "ServiceProvider",
            "inputs": {
              "parameters": {
                "messageId": "@triggerBody()?['messageId']",
                "lockToken": "@triggerBody()?['lockToken']"
              },
              "serviceProviderConfiguration": {
                "connectionName": "serviceBus",
                "operationId": "completeMessage",
                "serviceProviderId": "/serviceProviders/serviceBus"
              }
            },
            "runAfter": {}
          }
        },
        "else": {
          "actions": {
            "Abandon_message": {
              "type": "ServiceProvider",
              "inputs": {
                "parameters": {
                  "messageId": "@triggerBody()?['messageId']",
                  "lockToken": "@triggerBody()?['lockToken']"
                },
                "serviceProviderConfiguration": {
                  "connectionName": "serviceBus",
                  "operationId": "abandonMessage",
                  "serviceProviderId": "/serviceProviders/serviceBus"
                }
              },
              "runAfter": {}
            }
          }
        },
        "runAfter": {
          "Keep_lock_alive": [
            "Succeeded"
          ],
          "Set_processing_status": [
            "Succeeded"
          ]
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}
