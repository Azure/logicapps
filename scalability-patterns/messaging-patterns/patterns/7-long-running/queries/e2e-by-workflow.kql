// Parameters: replace the {{...}} tokens with literal values to run this query in the
// portal (Application Insights > Logs). Pattern 7 queries cover both workflows.
let startTime = datetime({{startUtc}});
let endTime = datetime({{endUtc}});
// End-to-end latency per pattern 7 workflow, from the producer's sentAtUtc to the end of the
// child call (the action with trackedProperties).
requests
| where timestamp between (startTime .. endTime)
| where customDimensions.Category == 'Workflow.Operations.Actions'
| extend tp = parse_json(tostring(customDimensions.trackedProperties))
| where tp.pattern == '7-long-running' and isnotempty(tp.sentAtUtc)
| extend workflowName = tostring(parse_json(tostring(customDimensions.resource)).workflowName)
| extend finishedAt = timestamp + totimespan(duration * 10000)
| summarize finishedAt = max(finishedAt), sentAt = min(todatetime(tp.sentAtUtc)) by workflowName, messageId = tostring(tp.messageId)
| extend e2eMs = datetime_diff('millisecond', finishedAt, sentAt)
| summarize messages = count(), p50 = percentile(e2eMs, 50), p95 = percentile(e2eMs, 95), p99 = percentile(e2eMs, 99), maxMs = max(e2eMs) by workflowName
