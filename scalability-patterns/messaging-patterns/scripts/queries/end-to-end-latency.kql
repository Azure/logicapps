// Parameters: Export-Results.ps1 replaces the {{...}} tokens. To run this query in the
// portal (Application Insights > Logs), replace them with literal values.
let startTime = datetime({{startUtc}});
let endTime = datetime({{endUtc}});
let workflow = '{{workflowName}}';
// Latency from the producer timestamp (sentAtUtc) and broker timestamp (enqueuedTimeUtc)
// to the end of the last action that carries trackedProperties.sentAtUtc.
// Contract: each pattern's entry workflow sets trackedProperties messageId, sentAtUtc and
// enqueuedTimeUtc on its final processing action.
requests
| where timestamp between (startTime .. endTime)
| where customDimensions.Category == 'Workflow.Operations.Actions'
| extend tp = parse_json(tostring(customDimensions.trackedProperties))
| where isnotempty(tp.sentAtUtc)
| extend workflowName = tostring(parse_json(tostring(customDimensions.resource)).workflowName)
| where workflowName == workflow
| extend messageId = tostring(tp.messageId), sentAt = todatetime(tp.sentAtUtc), enqueuedAt = todatetime(tp.enqueuedTimeUtc)
| extend finishedAt = timestamp + totimespan(duration * 10000)
| summarize finishedAt = max(finishedAt), sentAt = min(sentAt), enqueuedAt = min(enqueuedAt) by messageId
| extend e2eMs = datetime_diff('millisecond', finishedAt, sentAt), fromEnqueueMs = datetime_diff('millisecond', finishedAt, enqueuedAt)
| summarize messages = count(), p50 = percentile(e2eMs, 50), p95 = percentile(e2eMs, 95), p99 = percentile(e2eMs, 99), maxMs = max(e2eMs),
    enqueueP50 = percentile(fromEnqueueMs, 50), enqueueP95 = percentile(fromEnqueueMs, 95)
    by minute = bin(finishedAt, 1m)
| order by minute asc
