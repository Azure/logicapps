// Parameters: Export-Results.ps1 replaces the {{...}} tokens. To run this query in the
// portal (Application Insights > Logs), replace them with literal values.
let startTime = datetime({{startUtc}});
let endTime = datetime({{endUtc}});
let workflow = '{{workflowName}}';
// Duration percentiles per action across all workflows (one row per workflow/action).
// apiName identifies built-in connectors (serviceBus, AzureCosmosDB); actionType the action kind.
requests
| where timestamp between (startTime .. endTime)
| where customDimensions.Category == 'Workflow.Operations.Actions'
| extend workflowName = tostring(parse_json(tostring(customDimensions.resource)).workflowName),
         actionType = tostring(customDimensions.actionType), apiName = tostring(customDimensions.apiName)
| summarize count = count(), failed = countif(success == false), p50 = percentile(duration, 50), p95 = percentile(duration, 95), p99 = percentile(duration, 99)
    by workflowName, action = name, actionType, apiName
| order by workflowName asc, p95 desc
