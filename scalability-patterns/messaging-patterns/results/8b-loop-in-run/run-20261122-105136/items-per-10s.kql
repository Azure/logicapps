// Parameters: replace {{startUtc}}, {{endUtc}} and {{workflowName}} (Run-Queries.ps1 in this folder does this).
let startTime = datetime({{startUtc}});
let endTime = datetime({{endUtc}});
let workflow = '{{workflowName}}';// Items finished per 10 s (Process_order calls in the entry workflow), as items/s, plus Cosmos upserts per 10 s.
let calls = requests
| where timestamp between (startTime .. endTime)
| where customDimensions.Category == 'Workflow.Operations.Actions'
| where tostring(parse_json(tostring(customDimensions.resource)).workflowName) == workflow
| where tostring(parse_json(tostring(customDimensions.resource)).actionName) == 'Process_order' or name endswith 'Process_order'
| summarize itemCalls = count(), itemFailures = countif(tostring(success) =~ 'False') by bucket = bin(timestamp + totimespan(duration * 10000), 10s);
let ups = requests
| where timestamp between (startTime .. endTime)
| where customDimensions.Category == 'Workflow.Operations.Actions'
| where tostring(customDimensions.prop__actionName) == 'Upsert_order' or name endswith 'Upsert_order'
| summarize upserts = count() by bucket = bin(timestamp + totimespan(duration * 10000), 10s);
calls | join kind=fullouter ups on bucket
| project bucket = coalesce(bucket, bucket1), itemCalls = coalesce(itemCalls, 0), itemFailures = coalesce(itemFailures, 0), upserts = coalesce(upserts, 0)
| extend itemsPerSecond = round(itemCalls / 10.0, 2)
| order by bucket asc
