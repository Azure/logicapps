// Parameters: replace {{startUtc}}, {{endUtc}} and {{workflowName}} (Run-Queries.ps1 in this folder does this).
let startTime = datetime({{startUtc}});
let endTime = datetime({{endUtc}});
let workflow = '{{workflowName}}';// Failure isolation: per item (Process_order action), per run and per envelope (batchId).
// goodItemsLost counts items whose own child call succeeded but whose run still ended Failed.
let calls = requests
| where timestamp between (startTime .. endTime)
| where customDimensions.Category == 'Workflow.Operations.Actions'
| where tostring(parse_json(tostring(customDimensions.resource)).workflowName) == workflow
| where tostring(parse_json(tostring(customDimensions.resource)).actionName) == 'Process_order' or name endswith 'Process_order'
| extend tp = parse_json(tostring(customDimensions.trackedProperties)), runId = tostring(parse_json(tostring(customDimensions.resource)).runId)
| project itemId = tostring(tp.messageId), batchId = tostring(tp.batchId), runId, ok = tostring(success) =~ 'True';
let runs = traces
| where timestamp between (startTime .. endTime)
| where customDimensions.Category == 'Workflow.Operations.Runs' and customDimensions.EventName == 'WorkflowRunEnd'
| where tostring(parse_json(tostring(customDimensions.resource)).workflowName) == workflow
| project runId = tostring(parse_json(tostring(customDimensions.resource)).runId), runStatus = tostring(parse_json(tostring(customDimensions.prop__properties)).status);
let perItem = calls | summarize attempts = count(), anyOk = max(iff(ok, 1, 0)) by itemId, batchId, runId;
let batches = calls | summarize badInBatch = countif(not(ok)) by batchId;
perItem
| join kind=leftouter runs on runId
| summarize items = dcount(itemId), childCalls = sum(attempts), itemsOk = dcountif(itemId, anyOk == 1), itemsFailed = dcountif(itemId, anyOk == 0),
    runsSeen = dcount(runId), runsFailed = dcountif(runId, runStatus == 'Failed'), runsSucceeded = dcountif(runId, runStatus == 'Succeeded'),
    goodItemsInFailedRuns = dcountif(itemId, anyOk == 1 and runStatus == 'Failed')
| extend batchesSeen = toscalar(batches | count), batchesWithBadItem = toscalar(batches | where badInBatch > 0 | count)
