// Parameters: replace {{startUtc}}, {{endUtc}} and {{workflowName}} (Run-Queries.ps1 in this folder does this).
let startTime = datetime({{startUtc}});
let endTime = datetime({{endUtc}});
let workflow = '{{workflowName}}';
// End-to-end latency per item: from the moment the sender built the envelope (sentAtUtc) to the end of
// the item's Process_order call. Uses the last attempt per item. Also reports items per second over the window.
requests
| where timestamp between (startTime .. endTime)
| where customDimensions.Category == 'Workflow.Operations.Actions'
| where tostring(parse_json(tostring(customDimensions.resource)).workflowName) == workflow
| where name endswith 'Process_order'
| extend tp = parse_json(tostring(customDimensions.trackedProperties))
| extend itemId = tostring(tp.messageId), sentAt = todatetime(tp.sentAtUtc), endAt = timestamp + totimespan(duration * 10000), ok = tostring(success) =~ 'True'
| summarize endAt = max(endAt), sentAt = min(sentAt), anyOk = max(iff(ok, 1, 0)) by itemId
| extend e2eSeconds = (endAt - sentAt) / 1s
| summarize items = count(), itemsOk = countif(anyOk == 1), p50E2eS = percentile(e2eSeconds, 50), p95E2eS = percentile(e2eSeconds, 95), maxE2eS = max(e2eSeconds),
    firstSent = min(sentAt), lastDone = max(endAt)
| extend activeSeconds = (lastDone - firstSent) / 1s, itemsPerSecond = round(items / ((lastDone - firstSent) / 1s), 2)
