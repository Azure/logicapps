// Parameters: replace {{startUtc}}, {{endUtc}} and {{workflowName}} (Run-Queries.ps1 in this folder does this).
let startTime = datetime({{startUtc}});
let endTime = datetime({{endUtc}});
let workflow = '{{workflowName}}';// Per message: Upsert_limited executions (one per delivery) and the action retry count the runtime reports (customDimensions.retryHistory).
requests | where timestamp between (startTime .. endTime) | where customDimensions.Category == 'Workflow.Operations.Actions' | where tostring(parse_json(tostring(customDimensions.resource)).workflowName) == workflow | where tostring(parse_json(tostring(customDimensions.resource)).actionName) == 'Upsert_limited' | extend messageId = tostring(parse_json(tostring(customDimensions.trackedProperties)).messageId), retries = array_length(parse_json(tostring(customDimensions.retryHistory))), ok = resultCode == 'Succeeded' | summarize executions = count(), actionRetries = sum(coalesce(retries, 0)), succeeded = countif(ok) by messageId | summarize messages = count(), messagesWithRedelivery = countif(executions > 1), messagesWithActionRetry = countif(actionRetries > 0), avgExecutions = round(avg(executions), 3), maxExecutions = max(executions), avgActionRetries = round(avg(actionRetries), 3), maxActionRetries = max(actionRetries), neverSucceeded = countif(succeeded == 0)
