// Parameters: replace {{startUtc}}, {{endUtc}} and {{workflowName}} (Run-Queries.ps1 in this folder does this).
let startTime = datetime({{startUtc}});
let endTime = datetime({{endUtc}});
let workflow = '{{workflowName}}';// Run counts and duration percentiles for every workflow in the app (splitter, item and child runs).
traces
| where timestamp between (startTime .. endTime)
| where customDimensions.Category == 'Workflow.Operations.Runs' and customDimensions.EventName == 'WorkflowRunEnd'
| extend wf = tostring(parse_json(tostring(customDimensions.resource)).workflowName), status = tostring(parse_json(tostring(customDimensions.prop__properties)).status), durationMs = todouble(customDimensions.prop__durationInMilliseconds)
| summarize runs = count(), succeeded = countif(status == 'Succeeded'), failed = countif(status == 'Failed'), other = countif(status !in ('Succeeded', 'Failed')),
    p50Ms = percentile(durationMs, 50), p95Ms = percentile(durationMs, 95), maxMs = max(durationMs) by wf
| extend unusedWorkflowToken = workflow
| order by wf asc
