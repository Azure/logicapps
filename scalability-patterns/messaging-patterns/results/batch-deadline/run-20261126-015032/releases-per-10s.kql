// Parameters: replace {{startUtc}}, {{endUtc}} and {{workflowName}} (tools\Run-Queries.ps1 does this).
// Set startUtc to the moment the workflows were enabled (T0) so the "since start" columns measure the deadline.
let startTime = datetime({{startUtc}});
let endTime = datetime({{endUtc}});
let workflow = '{{workflowName}}';// Release size: items in each release, from the child runs started by each receiver run.
// Process_batch posts the whole batch to process-batch-item, which splits it into one run per item.
// Release size per 10 s = process-batch-item trigger rows, which carry no receiver name, so sizes are summed over both receivers.
requests
| where timestamp between (startTime .. endTime)
| where customDimensions.Category == 'Workflow.Operations.Actions'
| extend wf = tostring(parse_json(tostring(customDimensions.resource)).workflowName), act = tostring(parse_json(tostring(customDimensions.resource)).actionName)
| where act == 'Process_batch'
| summarize releases = count(), ok = countif(success == true), callP50Ms = percentile(duration, 50), callP95Ms = percentile(duration, 95) by wf, bin10 = bin(timestamp, 10s)
| order by bin10 asc, wf asc
| join kind=leftouter (requests | where timestamp between (startTime .. endTime) | where customDimensions.Category == 'Workflow.Operations.Triggers' | where tostring(parse_json(tostring(customDimensions.resource)).workflowName) == workflow | summarize itemsReleased = count() by bin10 = bin(timestamp, 10s)) on bin10
| project-away bin101
